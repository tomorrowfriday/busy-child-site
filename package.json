{
  "name": "busy-child-site",
  "version": "2.0.0",
  "private": true,
  "description": "Busy Child — production web & mobile platforms",
  "scripts": {
    "dev": "next dev",
    "up": "node scripts/start.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gates": "npm run typecheck && npm run lint && npm run coverage && npm run build"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
